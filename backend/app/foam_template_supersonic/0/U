/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (${U0} 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (${U0} 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        // Supersonic far field: outflow, not a wall. A slip wall reflects any
        // shock that reaches it straight back into the solution; zeroGradient
        // lets it leave, which is what keeps the domain small.
        type            zeroGradient;
    }
    model
    {
        type            noSlip;
    }
}

// ************************************************************************* //
