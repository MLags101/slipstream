/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         ${endTime};

deltaT          1;

writeControl    timeStep;

writeInterval   ${endTime};

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        log             no;

        patches         (model);
        rho             rhoInf;
        rhoInf          ${rho};
        magUInf         ${U0};
        lRef            ${lref};
        Aref            ${aref};
        CofR            (${cx} ${cy} ${cz});
        dragDir         (1 0 0);
        liftDir         (0 0 1);
        pitchAxis       (0 1 0);
    }

    forces1
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        log             no;

        patches         (model);
        rho             rhoInf;
        rhoInf          ${rho};
        CofR            (${cx} ${cy} ${cz});
    }

    // Peak velocity, watched by the runner. A broken surface (overlapping
    // shells, sub-mm gaps) can leave a near-sealed cavity whose pressure
    // solution drives a physically impossible jet through one bad face -
    // seen at 900x freestream - which poisons the force integrals long
    // before anything else in the log looks wrong.
    maxU
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             no;
        mode            magnitude;
        fields          (U);
    }

    // Peak k, for observability and the powered-fine regression. Kept as its
    // own function object so each .dat holds exactly one field and stays
    // trivially parsable.
    maxK
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             no;
        mode            magnitude;
        fields          (k);
    }

    solverInfo1
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
        log             no;
        fields          (U p k omega);
        writeResidualFields no;
    }

    surfaces1
    {
        type            surfaces;
        libs            (sampling);
        writeControl    onEnd;
        executeControl  onEnd;
        surfaceFormat   vtk;
        formatOptions
        {
            vtk
            {
                legacy      true;
                format      ascii;
            }
        }
        fields          (p U);
        interpolationScheme cellPoint;
        surfaces
        {
            modelSurface
            {
                type        patch;
                patches     (model);
                interpolate true;
            }
            sliceY
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict
                {
                    point   (0 ${sliceY} 0);
                    normal  (0 1 0);
                }
                interpolate true;
            }
            sliceZ
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict
                {
                    point   (0 0 0);
                    normal  (0 0 1);
                }
                interpolate true;
            }
        }
    }
}

// ************************************************************************* //
