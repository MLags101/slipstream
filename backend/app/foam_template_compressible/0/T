/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform ${T0};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ${T0};
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform ${T0};
        value           uniform ${T0};
    }
    walls
    {
        type            zeroGradient;
    }
    model
    {
        type            zeroGradient;
    }
}

