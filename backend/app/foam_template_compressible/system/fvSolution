/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }

    "(U|h|e|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
        nSweeps         1;
    }

    rho
    {
        solver          diagonal;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      no;
    // Pressure-velocity-density coupling. Needed once the flow is compressible
    // enough that density responds to pressure within the domain.
    transonic       ${transonic};
    pMinFactor      0.1;
    pMaxFactor      2.0;
}

// Compressible SIMPLE needs far more relaxation than the incompressible
// solver: density and enthalpy feed back into each other through the equation
// of state, and an unrelaxed rho drove T negative in 7 iterations on a Mach
// 0.04 box. These are the values OpenFOAM's own rhoSimpleFoam tutorials use.
relaxationFactors
{
    fields
    {
        p               0.3;
        rho             0.05;
    }
    equations
    {
        U               0.3;
        h               0.3;
        "(k|omega)"     0.7;
    }
}

cache
{
    grad(U);
}

